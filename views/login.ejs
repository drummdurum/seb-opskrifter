<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Opskrifter</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-sand-light min-h-screen flex flex-col">
  <nav class="bg-warm-beige border-b-4 border-red-accent shadow-md"><div class="container mx-auto px-4 py-4 flex justify-between items-center"><a href="/" class="text-2xl font-bold text-dark-brown">Opskrifter</a><a href="/register" class="btn-secondary">Opret konto</a></div></nav>
  <main class="container mx-auto px-4 py-10 flex-1">
    <section class="max-w-md mx-auto bg-white border-t-4 border-red-accent shadow-md p-6">
      <h1 class="text-3xl font-bold text-dark-brown mb-6">Log ind</h1>
      <% if (error) { %><p class="border-l-4 border-red-accent bg-sand-light p-3 text-red-accent mb-5" role="alert"><%= error %></p><% } %>
      <form action="/login" method="POST" class="space-y-5">
        <label class="block font-semibold text-dark-brown">Email
          <input type="email" name="email" value="<%= email %>" autocomplete="email" required class="w-full mt-1 px-4 py-3 border-2 border-warm-taupe rounded focus:ring-2 focus:ring-red-accent">
        </label>
        <label class="block font-semibold text-dark-brown">Adgangskode
          <input type="password" name="password" autocomplete="current-password" required class="w-full mt-1 px-4 py-3 border-2 border-warm-taupe rounded focus:ring-2 focus:ring-red-accent">
        </label>
        <button type="submit" class="btn-primary w-full py-3">Log ind</button>
      </form>
      <a href="/forgot-password" class="block text-center text-tree-brown hover:text-red-accent mt-4">Glemt adgangskode?</a>
      <p class="text-tree-brown text-center mt-5">Ny her? <a href="/register" class="font-semibold text-red-accent">Opret en konto</a></p>
    </section>
  </main>
</body>
</html>
