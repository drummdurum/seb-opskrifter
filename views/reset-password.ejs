<!DOCTYPE html><html lang="da"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Opskrifter</title><link rel="stylesheet" href="/css/output.css"></head>
<body class="bg-sand-light min-h-screen"><main class="container mx-auto px-4 py-16"><section class="max-w-md mx-auto bg-white border-t-4 border-red-accent shadow-md p-6"><h1 class="text-3xl font-bold text-dark-brown mb-5">Vælg ny adgangskode</h1><% if (error) { %><p class="border-l-4 border-red-accent bg-sand-light p-3 text-red-accent mb-5"><%= error %></p><% } %><form action="/reset-password" method="POST" class="space-y-5"><input type="hidden" name="token" value="<%= token %>"><label class="block font-semibold text-dark-brown">Ny adgangskode<input type="password" name="password" minlength="10" required autocomplete="new-password" class="w-full mt-1 px-4 py-3 border-2 border-warm-taupe rounded"></label><label class="block font-semibold text-dark-brown">Gentag adgangskode<input type="password" name="passwordConfirmation" minlength="10" required autocomplete="new-password" class="w-full mt-1 px-4 py-3 border-2 border-warm-taupe rounded"></label><button class="btn-primary w-full" type="submit">Gem adgangskode</button></form></section></main></body></html>
