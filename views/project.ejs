<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Strikkeprojekt</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-sand-light min-h-screen flex flex-col">
  <nav class="bg-warm-beige shadow-md border-b-4 border-red-accent">
    <div class="container mx-auto px-4 py-4">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <a href="/" class="text-2xl font-bold text-dark-brown">Opskrifter</a>
        <div class="flex flex-wrap justify-center gap-4 items-center">
          <a href="/" class="text-dark-brown hover:text-red-accent">Alle opskrifter</a>
          <a href="/tags" class="text-dark-brown hover:text-red-accent">Tags</a>
          <a href="/taellere" class="font-semibold text-red-accent">Strik</a>
          <a href="/indkoebsliste" class="text-dark-brown hover:text-red-accent">Indkøbsliste</a>
          <div class="flex flex-nowrap gap-2"><a href="https://seb-opskrifter-production.up.railway.app/taellere" class="btn-secondary whitespace-nowrap">+ Ny strikkeopskrift</a><a href="/ny" class="btn-primary whitespace-nowrap">+ Ny opskrift</a></div>
          <form action="/logout" method="POST"><button type="submit" class="text-sm font-semibold text-tree-brown hover:text-red-accent">Log ud</button></form>
        </div>
      </div>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-8 flex-1">
    <a href="/taellere" class="inline-block text-tree-brown hover:text-red-accent font-semibold mb-5">← Alle strikkeprojekter</a>
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
      <div>
        <p class="text-sm font-semibold uppercase text-olive-muted mb-2">Strikkeprojekt</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-dark-brown break-words"><%= project.name %></h1>
      </div>
      <% const statusLabels = { planned: 'Planlagt', in_progress: 'I gang', finished: 'Færdigt', paused: 'På pause', shame_corner: 'Skammekrogen' }; %>
      <span class="self-start sm:self-auto bg-olive-muted text-white px-3 py-2 rounded font-semibold"><%= statusLabels[project.status] || 'I gang' %></span>
    </header>

    <section class="counter-card bg-white border-t-4 border-red-accent shadow-md p-5 sm:p-6 mb-8 max-w-3xl" data-counter-id="<%= project._id %>" data-session-active="<%= project.activeSession ? 'true' : 'false' %>" data-session-rounds="<%= project.activeSession ? project.activeSession.rounds : 0 %>" data-session-started-at="<%= project.activeSession && project.activeSession.startedAt ? project.activeSession.startedAt.toISOString() : '' %>">
      <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_minmax(12rem,18rem)] gap-5 items-center">
        <div class="text-center" aria-live="polite">
          <span class="block text-sm font-semibold uppercase text-tree-brown">Omgang</span>
          <strong class="counter-value block text-7xl font-bold text-dark-brown leading-none mt-2"><%= project.count %></strong>
        </div>
        <div>
          <div class="session-panel bg-sand-light border-l-4 border-olive-muted p-3 mb-3">
            <strong class="session-title block text-dark-brown"><%= project.activeSession ? 'Session i gang' : 'Klar til en session' %></strong>
            <span class="session-summary block text-sm text-tree-brown mb-2"><%= project.activeSession ? `${project.activeSession.rounds} omgange i denne session` : 'Start her og fortsæt på mobil eller pc.' %></span>
            <button type="button" data-session-action="<%= project.activeSession ? 'end' : 'start' %>" class="session-toggle btn-secondary w-full"><%= project.activeSession ? 'Afslut session' : 'Start session' %></button>
          </div>
          <button type="button" data-action="increment" class="w-full min-h-24 bg-red-accent hover:bg-red-accent-dark active:bg-red-accent-bright disabled:opacity-60 text-white text-2xl font-bold rounded shadow">+ 1 omgang</button>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <button type="button" data-action="decrement" class="min-h-12 border-2 border-warm-taupe text-dark-brown font-semibold rounded hover:bg-sand-light">− 1</button>
            <button type="button" data-action="reset" class="min-h-12 border-2 border-red-accent text-red-accent font-semibold rounded hover:bg-red-accent hover:text-white">Nulstil</button>
          </div>
        </div>
      </div>
      <p class="counter-error text-red-accent text-sm mt-3 hidden" role="alert"></p>
      <p class="counter-sync text-tree-brown text-xs mt-2" aria-live="polite">Synkroniseret</p>
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_minmax(20rem,28rem)] gap-8 items-start">
      <div class="space-y-8">
        <section id="images">
          <div class="flex items-center justify-between gap-3 mb-4">
            <h2 class="text-2xl font-bold text-dark-brown">Billeder</h2>
            <span class="text-sm text-tree-brown"><%= project.images.length %> stk.</span>
          </div>
          <% if (project.images.length) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
              <% project.images.slice().reverse().forEach(image => { %>
                <figure class="bg-white border border-warm-taupe shadow-md overflow-hidden">
                  <img src="/uploads/projects/<%= image.filename %>" alt="<%= image.caption || project.name %>" class="w-full aspect-square object-cover">
                  <figcaption class="flex items-start justify-between gap-3 p-3">
                    <span class="text-sm text-dark-brown"><%= image.caption || 'Projektbillede' %></span>
                    <form action="/taellere/<%= project._id %>/images/<%= image._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Vil du slette billedet?')">
                      <button class="text-sm font-semibold text-red-accent" type="submit">Slet</button>
                    </form>
                  </figcaption>
                </figure>
              <% }) %>
            </div>
          <% } else { %>
            <p class="border-2 border-dashed border-warm-taupe p-6 text-center text-tree-brown mb-5">Ingen billeder på projektet endnu.</p>
          <% } %>
          <form action="/taellere/<%= project._id %>/images" method="POST" enctype="multipart/form-data" class="bg-white border-l-4 border-olive-muted p-4 grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3">
            <div class="space-y-3">
              <label class="block text-sm font-semibold text-dark-brown">Vælg billede
                <input name="image" type="file" accept="image/jpeg,image/png,image/gif,image/webp" required class="block w-full mt-1 border-2 border-warm-taupe rounded p-2">
              </label>
              <label class="block text-sm font-semibold text-dark-brown">Billedtekst
                <input name="caption" type="text" maxlength="150" placeholder="F.eks. første ærme færdigt" class="block w-full mt-1 border-2 border-warm-taupe rounded px-3 py-2">
              </label>
            </div>
            <button type="submit" class="btn-secondary self-end">Upload</button>
          </form>
        </section>

        <section id="documents">
          <% const documents = project.documents || []; %>
          <div class="flex items-center justify-between gap-3 mb-4">
            <h2 class="text-2xl font-bold text-dark-brown">Strikkeopskrift som PDF</h2>
            <span class="text-sm text-tree-brown"><%= documents.length %> stk.</span>
          </div>
          <% if (documents.length) { %>
            <div class="divide-y divide-warm-taupe bg-white border border-warm-taupe shadow-md mb-5">
              <% documents.slice().reverse().forEach(document => { %>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4">
                  <div class="min-w-0">
                    <strong class="block text-dark-brown break-words"><%= document.title || document.originalName %></strong>
                    <% if (document.title) { %><span class="block text-sm text-tree-brown break-words"><%= document.originalName %></span><% } %>
                  </div>
                  <div class="flex items-center gap-4 shrink-0">
                    <a href="/uploads/projects/pdfs/<%= document.filename %>" target="_blank" rel="noopener noreferrer" class="btn-secondary">Åbn PDF</a>
                    <form action="/taellere/<%= project._id %>/documents/<%= document._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Vil du slette PDF-filen?')">
                      <button type="submit" class="text-sm font-semibold text-red-accent">Slet</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="border-2 border-dashed border-warm-taupe p-6 text-center text-tree-brown mb-5">Der er endnu ikke gemt en PDF på projektet.</p>
          <% } %>
          <form action="/taellere/<%= project._id %>/documents" method="POST" enctype="multipart/form-data" class="bg-white border-l-4 border-oat-brown p-4 grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3">
            <div class="space-y-3">
              <label class="block text-sm font-semibold text-dark-brown">Vælg PDF
                <input name="pdf" type="file" accept="application/pdf,.pdf" required class="block w-full mt-1 border-2 border-warm-taupe rounded p-2">
              </label>
              <label class="block text-sm font-semibold text-dark-brown">Titel
                <input name="title" type="text" maxlength="150" placeholder="F.eks. Sweater størrelse M" class="block w-full mt-1 border-2 border-warm-taupe rounded px-3 py-2">
              </label>
            </div>
            <button type="submit" class="btn-secondary self-end">Gem PDF</button>
          </form>
        </section>

        <section id="notes">
          <h2 class="text-2xl font-bold text-dark-brown mb-4">Noter og erfaringer</h2>
          <form action="/taellere/<%= project._id %>/notes" method="POST" class="bg-white border-l-4 border-olive-muted p-4 mb-5">
            <label for="note-text" class="block font-semibold text-dark-brown mb-2">Ny note</label>
            <textarea id="note-text" name="text" maxlength="2000" rows="4" required placeholder="Hvad har du lavet eller lært undervejs?" class="w-full border-2 border-warm-taupe rounded px-3 py-2 mb-3"></textarea>
            <button type="submit" class="btn-secondary">Tilføj note</button>
          </form>
          <% if (project.notes.length) { %>
            <div class="border-l-2 border-warm-taupe ml-2 space-y-4">
              <% project.notes.slice().reverse().forEach(note => { %>
                <article class="relative bg-white shadow-sm p-4 ml-5">
                  <span class="absolute w-3 h-3 bg-red-accent rounded-full -left-7 top-5"></span>
                  <div class="flex justify-between gap-3 mb-2">
                    <time class="text-sm font-semibold text-tree-brown"><%= new Intl.DateTimeFormat('da-DK', { dateStyle: 'medium' }).format(note.createdAt) %></time>
                    <form action="/taellere/<%= project._id %>/notes/<%= note._id %>?_method=DELETE" method="POST">
                      <button type="submit" class="text-sm text-red-accent font-semibold">Slet</button>
                    </form>
                  </div>
                  <p class="text-dark-brown whitespace-pre-wrap"><%= note.text %></p>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-tree-brown">Der er endnu ingen noter på projektet.</p>
          <% } %>
        </section>
      </div>

      <aside class="bg-white shadow-md border-t-4 border-oat-brown p-5">
        <h2 class="text-xl font-bold text-dark-brown mb-5">Projektoplysninger</h2>
        <% const yarn = project.yarn || {}; const pattern = project.pattern || {}; %>
        <% if (yarn.metersPerSkein && yarn.skeinsUsed) { %>
          <div class="bg-sand-light p-4 mb-5">
            <span class="block text-sm text-tree-brown">Beregnet garnforbrug</span>
            <strong class="text-2xl text-dark-brown"><%= Math.round(yarn.metersPerSkein * yarn.skeinsUsed) %> meter</strong>
          </div>
        <% } %>
        <form action="/taellere/<%= project._id %>/details?_method=PUT" method="POST" class="space-y-4">
          <label class="block text-sm font-semibold text-dark-brown">Projektnavn
            <input name="name" value="<%= project.name %>" maxlength="80" required class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
          </label>
          <label class="block text-sm font-semibold text-dark-brown">Status
            <select name="status" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
              <% Object.entries(statusLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= project.status === value ? 'selected' : '' %>><%= label %></option><% }) %>
            </select>
          </label>
          <fieldset class="border-t border-warm-taupe pt-4 grid grid-cols-1 gap-4">
            <legend class="font-bold text-dark-brown pr-2">Opskrift</legend>
            <label class="text-sm font-semibold text-dark-brown">Navn
              <input name="patternName" value="<%= pattern.name || '' %>" maxlength="150" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Link
              <input name="patternUrl" value="<%= pattern.url || '' %>" maxlength="500" type="url" placeholder="https://..." class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <% if (pattern.url && /^https?:\/\//i.test(pattern.url)) { %><a href="<%= pattern.url %>" target="_blank" rel="noopener noreferrer" class="text-red-accent font-semibold">Åbn opskriften ↗</a><% } %>
          </fieldset>
          <fieldset class="border-t border-warm-taupe pt-4 grid grid-cols-2 gap-4">
            <legend class="font-bold text-dark-brown pr-2">Garn</legend>
            <label class="text-sm font-semibold text-dark-brown">Producent
              <input name="yarnBrand" value="<%= yarn.brand || '' %>" maxlength="100" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Garnnavn
              <input name="yarnName" value="<%= yarn.name || '' %>" maxlength="100" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Farve
              <input name="yarnColor" value="<%= yarn.color || '' %>" maxlength="100" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Partinummer
              <input name="dyeLot" value="<%= yarn.dyeLot || '' %>" maxlength="80" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Meter pr. nøgle
              <input name="metersPerSkein" type="number" min="1" value="<%= yarn.metersPerSkein || '' %>" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Gram pr. nøgle
              <input name="gramsPerSkein" type="number" min="1" value="<%= yarn.gramsPerSkein || '' %>" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown col-span-2">Brugte nøgler
              <input name="skeinsUsed" type="number" min="0" step="0.1" value="<%= yarn.skeinsUsed ?? '' %>" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
          </fieldset>
          <fieldset class="border-t border-warm-taupe pt-4 grid grid-cols-2 gap-4">
            <legend class="font-bold text-dark-brown pr-2">Mål</legend>
            <label class="text-sm font-semibold text-dark-brown">Pind (mm)
              <input name="needleSize" type="number" min="0.5" step="0.25" value="<%= project.needleSize || '' %>" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown">Størrelse
              <input name="projectSize" value="<%= project.projectSize || '' %>" maxlength="80" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
            <label class="text-sm font-semibold text-dark-brown col-span-2">Strikkefasthed
              <input name="gauge" value="<%= project.gauge || '' %>" maxlength="120" placeholder="F.eks. 20 m x 28 p = 10 cm" class="w-full mt-1 px-3 py-2 border-2 border-warm-taupe rounded">
            </label>
          </fieldset>
          <button type="submit" class="btn-secondary w-full">Gem projektoplysninger</button>
        </form>
      </aside>
    </div>
  </main>
  <footer class="bg-dark-brown text-sand-light text-center py-4 mt-10 border-t-4 border-red-accent"><p>&copy; <%= new Date().getFullYear() %> Opskrifter Database</p></footer>
  <script src="/js/main.js"></script>
</body>
</html>
