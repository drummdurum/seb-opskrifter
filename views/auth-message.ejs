<!DOCTYPE html><html lang="da"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Opskrifter</title><link rel="stylesheet" href="/css/output.css"></head>
<body class="bg-sand-light min-h-screen"><main class="container mx-auto px-4 py-16"><section class="max-w-lg mx-auto bg-white border-t-4 border-olive-muted shadow-md p-7 text-center"><h1 class="text-3xl font-bold text-dark-brown mb-3"><%= heading %></h1><p class="text-tree-brown mb-6"><%= message %></p><% if (developmentUrl) { %><a href="<%= developmentUrl %>" class="btn-secondary inline-block mb-4">Åbn udviklingslink</a><p class="text-xs text-tree-brown">Dette link vises kun lokalt, når SMTP ikke er sat op.</p><% } else { %><a href="/login" class="btn-secondary inline-block">Til login</a><% } %></section></main></body></html>
