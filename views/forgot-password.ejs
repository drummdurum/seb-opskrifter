<!DOCTYPE html><html lang="da"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Opskrifter</title><link rel="stylesheet" href="/css/output.css"></head>
<body class="bg-sand-light min-h-screen"><main class="container mx-auto px-4 py-16"><section class="max-w-md mx-auto bg-white border-t-4 border-red-accent shadow-md p-6"><h1 class="text-3xl font-bold text-dark-brown mb-3">Glemt adgangskode</h1><% if (sent) { %><p class="text-tree-brown mb-5">Hvis kontoen findes, er der sendt et link til at vælge en ny adgangskode.</p><% if (developmentUrl) { %><a href="<%= developmentUrl %>" class="btn-secondary inline-block">Åbn udviklingslink</a><% } %><% } else { %><form action="/forgot-password" method="POST" class="space-y-5"><label class="block font-semibold text-dark-brown">Email<input type="email" name="email" required autocomplete="email" class="w-full mt-1 px-4 py-3 border-2 border-warm-taupe rounded"></label><button class="btn-primary w-full" type="submit">Send nulstillingslink</button></form><% } %><a href="/login" class="block text-center text-tree-brown mt-5">Tilbage til login</a></section></main></body></html>
