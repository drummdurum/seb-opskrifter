{
  "name": "opskrifter-database",
  "version": "1.0.0",
  "description": "Recipe database web application with Node.js, Express, MongoDB, and EJS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:seed": "node scripts/seed-test-data.js",
    "build:css": "npx tailwindcss -i ./public/css/styles.css -o ./public/css/output.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/styles.css -o ./public/css/output.css --watch"
  },
  "keywords": [
    "recipes",
    "express",
    "mongodb",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "googleapis": "^174.0.1",
    "method-override": "^3.0.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0"
  }
}
