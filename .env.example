# MongoDB Connection
# Lokal udvikling (Docker): mongodb://localhost:27017/opskrifter
# Railway/produktion: brug din sky-database (Atlas eller Railway MongoDB)
MONGODB_URI=mongodb://localhost:27017/opskrifter

# Server Port (Railway sætter selv PORT — lad den være tom i produktion)
PORT=3000

# Node Environment (production i Railway)
NODE_ENV=development

# --- Mail-fane: Gmail OAuth ---
# Redirect-URI skal også være tilføjet i Google Cloud Console.
# Lokalt: http://localhost:8080/api/auth/google/callback
# Railway: https://<dit-domæne>.up.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=din-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dit-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Krypteringsnøgle til gemte Gmail-tokens (64 hex-tegn)
# Generér: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# OpenAI til AI-klassificering og svarforslag
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
